# ============================================================================
# Aviothic Breast Cancer Report Copilot — Environment Variables
# ============================================================================
# Copy this file to .env and fill in values. Never commit .env to git.

# ---------- Authentication ----------
# API key for header-based auth (X-API-Key header).
# Generate a strong random key, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
AVIOTHIC_API_KEY=change-me-to-a-real-key

# ---------- Upload ----------
# Maximum upload file size in bytes (default: 52428800 = 50 MB)
AVIOTHIC_UPLOAD_MAX_BYTES=52428800

# ---------- Storage ----------
# Directory for temporary upload storage (default: ./uploads)
AVIOTHIC_UPLOAD_DIR=./uploads

# ---------- Logging ----------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
AVIOTHIC_LOG_LEVEL=INFO

# ---------- Environment ----------
# Runtime environment: development, staging, production (default: development)
AVIOTHIC_ENV=development
